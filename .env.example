# Public settlement deployment. Foundry reads the root .env automatically.
# Private CLI values only: never copy these into web/.env.local.
GNOSIS_RPC_URL=https://rpc.gnosischain.com
# Hex private key including 0x; fill in .env, never in this example.
DEPLOYER_PRIVATE_KEY=
# Etherscan V2 API key, used to verify on Gnosisscan.
ETHERSCAN_API_KEY=
