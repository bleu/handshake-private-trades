{
  "name": "private-trade-links",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w web",
    "lint:web": "npm run lint -w web",
    "format": "prettier --write . && forge fmt",
    "format:check": "prettier --check . && forge fmt --check",
    "build:contracts": "forge build",
    "lint:contracts": "solhint 'contracts/**/*.sol' --max-warnings 0 && .tools/bin/lintspec contracts",
    "check": "npm run format:check && npm run lint:web && npm run typecheck && npm run lint:contracts && npm run build:contracts && npm run test:contracts && npm run config:smoke && npm run abi:check && npm run build:smoke",
    "local:start": "node scripts/local-chain.mjs start",
    "local:reset": "node scripts/local-chain.mjs reset",
    "local:fixtures": "node scripts/local-chain.mjs fixtures",
    "local:smoke": "node scripts/local-chain.mjs smoke",
    "test:e2e": "npm run test:e2e -w web",
    "test:contracts": "forge test",
    "abi:export": "node scripts/export-abi.mjs",
    "abi:check": "node scripts/export-abi.mjs --check",
    "local:deploy": "node scripts/local-chain.mjs deploy",
    "local:settlement-smoke": "node scripts/settlement-smoke.mjs",
    "build:smoke": "node scripts/build-smoke.mjs",
    "config:smoke": "node scripts/config-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "prettier": "3.8.2",
    "solhint-community": "4.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0"
  }
}
