# Browser-visible configuration only. Never place private keys here.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_GNOSIS_RPC_URL=
# Development-only network. Public builds must not enable Anvil.
NEXT_PUBLIC_ENABLE_ANVIL=false
# Set only after the approved Gnosis deployment. ID 1 must never be remapped.
# Missing configuration disables that deployment in development and rejects public builds.
NEXT_PUBLIC_GNOSIS_SETTLEMENT_ADDRESS=
